# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Run artefacts — regenerated, never committed
runs/*
!runs/.gitkeep

# Base pools are generated by Stage 9. Commit pool_train and pool_dev once
# they are frozen; NEVER commit pool_final — the whole point is that nobody
# looks at it. See plan §10.4.
bases/pool_final.json
# Journals and active locks are local recovery evidence, not source files.
# Back them up with the study folder; ignoring a file is not permission to delete it.
**/*.progress.sqlite3*
bases/.*.lock
experiments/.*.lock
experiments/*.final-started.json

# TensorBoard
tb_logs/

# Design figures — regenerate with `python tools/preview_motifs.py`
figures/
# Local dependency cache and verification outputs
.uv-cache/
.browser-cache/
.pytest_cache/
artifacts/
.ipynb_checkpoints/
.venv-demo/
.env
.env.*
!.env.example
.streamlit/secrets.toml
.DS_Store

# Additional exclusions for the SageMaker code handover
*.zip
*.tar
*.tar.gz
*.tgz
*.pt
*.pth
*.pkl
*.pickle
*.sqlite3
*.sqlite3-*
